# Environment Configuration for AI Wellbeing Assistant
# Copy this file to .env and customize values as needed.
# NEVER commit .env with real secrets to version control.

# LLM Provider: 'mock' (default for offline/testing) or 'gemini' / 'openai'
LLM_PROVIDER=mock

# Model identifier (set a current model name in your .env, e.g. for Gemini)
LLM_MODEL=<set a current Gemini model name>

# Generation temperature (0.0 to 1.0)
LLM_TEMPERATURE=0.7

# API key for the chosen provider (leave empty when using mock provider)
LLM_API_KEY=

# Stage 2 Risk Classifier Provider: 'mock' (default for offline/testing) or 'gemini'
CLASSIFIER_PROVIDER=mock

# Stage 2 Risk Classifier Model identifier (set a pinned Gemini model name, e.g. gemini-3.5-flash-lite; never a -latest alias)
CLASSIFIER_MODEL=

# Stage 2 Risk Classifier HTTP timeout in seconds (default: 30)
CLASSIFIER_TIMEOUT=30

# Audit log JSONL file path (default under gitignored logs/ directory; zero raw message text or PII)
AUDIT_LOG_PATH=logs/audit.jsonl
