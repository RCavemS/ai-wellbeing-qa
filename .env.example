# Environment Configuration for AI Wellbeing Assistant
# Copy this file to .env and customize values as needed.
# NEVER commit .env with real secrets to version control.

# LLM Provider: 'mock' (default for offline/testing) or 'gemini' / 'openai'
LLM_PROVIDER=mock

# Model identifier
GEMINI_MODEL=<set a current Gemini model name>
LLM_MODEL=<set a current Gemini model name>

# Generation temperature (0.0 to 1.0)
LLM_TEMPERATURE=0.7

# API key for the chosen provider (leave empty when using mock provider)
LLM_API_KEY=
